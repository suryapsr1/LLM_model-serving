# Copy this file to .env to override Docker Compose defaults.
# The model directory must exist; the GGUF file must be readable by containers.
MODEL_DIR=./models
MODEL_FILENAME=Llama-3.2-1B-Instruct-Q4_K_M.gguf
API_PORT=8000
LOCAL_N_CTX=2048
LOCAL_N_THREADS=4

# Optional cloud fallback. Leave the key empty to use only the local model.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
